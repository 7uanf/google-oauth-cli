{
  "name": "google-oauth-cli",
  "version": "1.2.0",
  "description": "Google OAuth 2.0 (consent screen, web and desktop clients, secrets, test users, publishing) and Google Analytics 4 (property, stream, retention, access, reports) from the terminal.",
  "keywords": [
    "google-oauth",
    "oauth2",
    "oauth-client",
    "google-cloud-console",
    "playwright-core",
    "browser-automation",
    "cli",
    "client-id",
    "client-secret",
    "consent-screen",
    "auth-js",
    "next-auth",
    "publish-oauth-app",
    "test-users",
    "google-analytics",
    "ga4",
    "analytics-admin-api",
    "measurement-id",
    "desktop-oauth-client"
  ],
  "homepage": "https://github.com/Z1Code/google-oauth-cli#readme",
  "bugs": {
    "url": "https://github.com/Z1Code/google-oauth-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Z1Code/google-oauth-cli.git"
  },
  "author": "Z1Code",
  "license": "MIT",
  "type": "module",
  "bin": {
    "google-oauth-cli": "cli.mjs",
    "gauth": "cli.mjs",
    "google-oauth-mcp": "mcp/server.mjs",
    "ga": "ga.mjs"
  },
  "main": "lib/consent.mjs",
  "exports": {
    ".": "./lib/consent.mjs",
    "./chrome": "./lib/chrome.mjs",
    "./console": "./lib/console.mjs"
  },
  "files": [
    "cli.mjs",
    "ga.mjs",
    "lib/",
    "mcp/",
    "tools/",
    "docs/",
    "README.md",
    "SKILL.md",
    "AGENTS.md",
    "llms.txt"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node cli.mjs",
    "status": "node cli.mjs status",
    "mcp": "node mcp/server.mjs",
    "check": "node cli.mjs --help"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright-core": "^1.59.1",
    "zod": "^4.6.5"
  }
}
